{
  "name": "@accident/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sim": "VITE_BACKEND=sim vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:sim": "VITE_BACKEND=sim vite build --outDir dist-sim",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@accident/engine": "workspace:*",
    "@accident/protocol": "workspace:*",
    "@accident/solana": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "@supabase/supabase-js": "2.117.2",
    "bs58": "6.0.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  }
}
